{
  "name": "vaultpilot-mcp",
  "version": "0.0.0",
  "description": "Self-custodial DeFi for AI agents — agent proposes, you approve on your Ledger. GSD-planned rebuild of vaultpilot-mcp.",
  "type": "module",
  "bin": {
    "vaultpilot-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CONTEXT.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "check": "node dist/index.js --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "build:binary": "pkg . --fallback-to-source --out-path dist-binaries --compress GZip",
    "build:binary:linux-x64": "pkg . --fallback-to-source --target node22-linux-x64 --out-path dist-binaries",
    "build:binary:macos-x64": "pkg . --fallback-to-source --target node22-macos-x64 --out-path dist-binaries",
    "build:binary:macos-arm64": "pkg . --fallback-to-source --target node22-macos-arm64 --out-path dist-binaries",
    "build:binary:windows-x64": "pkg . --fallback-to-source --target node22-win-x64 --out-path dist-binaries"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js",
      "node_modules/multiformats/cjs/src/**/*.js",
      "node_modules/uint8arrays/cjs/src/**/*.js",
      "node_modules/@ledgerhq/devices/lib/**/*.js",
      "node_modules/@ledgerhq/hw-transport/lib/**/*.js",
      "node_modules/@ledgerhq/errors/lib/**/*.js"
    ],
    "assets": [
      "package.json",
      "node_modules/usb/prebuilds/**",
      "node_modules/@serialport/bindings-cpp/prebuilds/**",
      "node_modules/node-hid/build/**"
    ],
    "sea": true
  },
  "engines": {
    "node": ">=18.17"
  },
  "overrides": {
    "@ledgerhq/hw-transport-node-hid": "6.32.0",
    "@ledgerhq/hw-app-solana": "7.9.0",
    "@ledgerhq/hw-app-trx": "6.34.0",
    "rpc-websockets": {
      "uuid": "8.3.2"
    }
  },
  "license": "BUSL-1.1",
  "author": "Slava Zhygulin",
  "dependencies": {
    "@clack/prompts": "^1.4.0",
    "@ledgerhq/hw-app-btc": "10.22.1",
    "@ledgerhq/hw-app-solana": "7.9.0",
    "@ledgerhq/hw-app-trx": "6.34.0",
    "@ledgerhq/hw-transport-node-hid": "6.32.0",
    "@ledgerhq/ledger-bitcoin": "^0.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "@walletconnect/sign-client": "^2.23.9",
    "@walletconnect/utils": "^2.23.9",
    "bip32": "^5.0.1",
    "bitcoinjs-lib": "^7.0.1",
    "bs58": "^5.0.0",
    "bs58check": "^4.0.0",
    "tiny-secp256k1": "^2.2.4",
    "tronweb": "6.3.0",
    "viem": "^2.48.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@yao-pkg/pkg": "^6.19.0",
    "patch-package": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
